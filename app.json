{
  "expo": {
    "name": "Xonbay Business",
    "slug": "xonbay-business-app",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "xonbay-business",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dimarak.xonbay.business",
      "supportsTablet": false
    },
    "android": {
      "package": "com.dimarak.xonbay.business",

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102A63"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        { "locationWhenInUsePermission": "Xonbay Business uses your location to confirm that your shop is near the area you select." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Xonbay Business lets you choose a logo for your shop." }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#102A63"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
